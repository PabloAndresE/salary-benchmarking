# Imagen de la API de produccion (FastAPI + juez + traductor + base), solo CPU.
#
# Los modelos y la base NO estan en git: `infra/construir_api.sh` arma un contexto de
# build con el codigo y la carpeta `artefactos/` (modelos + base) y construye desde ahi.
# Asi la imagen lleva todo dentro y al arrancar no descarga nada.
#
# Las capas van de lo que menos cambia a lo que mas: dependencias -> modelos -> base ->
# codigo. Un cambio de codigo reconstruye solo la ultima capa.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# torch de CPU, la misma version que la del servicio actual
RUN pip install torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu

COPY requirements-api.txt ./
RUN pip install -r requirements-api.txt

# Modelos y base: capas grandes que cambian poco
COPY artefactos/modelos ./modelos
COPY artefactos/base ./base

# Codigo, desde `src/` como corre hoy en el H200. NO `pip install .`: el package-data de
# pyproject solo declara `config/*.yaml`, y la API instalada perderia `datos/ciiu.json` y
# los csv de glosario y sinonimos.
COPY src ./src
ENV PYTHONPATH=/app/src

# Usuario sin privilegios. La API no escribe en disco: trabajos y cache viven en memoria.
RUN useradd --system --uid 10001 --no-create-home benchmarking
USER benchmarking

# la version del producto y de la base viajan a cada carga guardada (`registro_nominas`)
ARG VERSION_API=dev
ARG VERSION_BASE=base_v31
ENV VERSION_API=${VERSION_API} \
    VERSION_BASE=${VERSION_BASE}

ENV BASE_REFERENCIA=/app/base/base_referencia.npz \
    JUEZ=/app/modelos/juez \
    TRADUCTOR=/app/modelos/opus-mt-en-es \
    # el resolver c-ares de gRPC fallaba contra Vertex desde el H200; el nativo no
    GRPC_DNS_RESOLVER=native \
    # torch usa todos los nucleos que ve; en una maquina compartida hay que acotarlo
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    PORT=8080

# Smoke de empaquetado: si falta un dato del paquete, falla el BUILD y no el arranque
RUN python -c "import benchmarking.servicio.api"

EXPOSE 8080
# Cloud Run inyecta PORT; fuera de Cloud Run vale el 8080 de arriba
CMD ["sh", "-c", "exec uvicorn benchmarking.servicio.api:app --host 0.0.0.0 --port ${PORT}"]
